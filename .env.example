###############################################################################
# CorporateNexus — Multi-tenant corporate SaaS hub
# Copy to .env and fill secrets. NEVER commit a real .env (see .gitignore).
###############################################################################

APP_NAME=CorporateNexus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Central app URL. Tenants are identified by subdomain of this apex host.
APP_URL=http://nexus.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

# --- Multi-tenancy ---------------------------------------------------------
# Apex domain that hosts the central app (registration, billing, admin).
# Requests to *.<this host> are resolved to a tenant by subdomain.
CENTRAL_DOMAIN=nexus.localhost
# Production: nexus.carlosgardea.com

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: PostgreSQL 18 (central) -------------------------------------
# The CENTRAL connection holds the tenant registry, billing and central users.
# Tenant databases are created on-demand from the `tenant_template` settings
# in config/tenancy.php and are NEVER the home of billing/registry data.
# Inside Sail the app reaches Postgres via the `pgsql` service name on 5432.
# From the host, connect on FORWARD_DB_PORT (5436). Tenant DBs are created
# on-demand by stancl/tenancy, so DB_USERNAME must have CREATEDB (the Sail
# postgres superuser does).
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=corporatenexus
DB_USERNAME=corporatenexus
DB_PASSWORD=secret

# Tenant DB naming. stancl/tenancy creates one DB per tenant: <prefix><uuid>.
TENANCY_DB_PREFIX=tenant_
TENANCY_DB_SUFFIX=

# --- Sessions (server-side, Valkey-backed in prod) -------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leading dot so the cookie is shared across tenant subdomains.
SESSION_DOMAIN=.nexus.localhost
# MUST be true in production (HTTPS only). Leave unset/false only for local http.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX is set per-tenant automatically by the tenancy bootstrapper.

# --- Valkey 8 (Redis-compatible: cache + queue + sessions) -----------------
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Feature flags (Laravel Pennant) ---------------------------------------
# `database` driver persists per-tenant flags; tests use `array`.
PENNANT_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@nexus.carlosgardea.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Octane (FrankenPHP) ---------------------------------------------------
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

VITE_APP_NAME="${APP_NAME}"

# --- Sail (local Docker) host port forwarding ------------------------------
# Remapped to avoid clashing with omnibus-cms (8088/5433/6380/5173) and
# omnibus-uniges (8090/5434/6381). See compose.yaml.
APP_PORT=8092
VITE_PORT=5176
FORWARD_DB_PORT=5436
FORWARD_REDIS_PORT=6383
FORWARD_MAILPIT_PORT=1027
FORWARD_MAILPIT_DASHBOARD_PORT=8027
WWWUSER=1000
WWWGROUP=1000
